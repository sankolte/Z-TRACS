# Z-TRACS AWS Production Backend Environment Template
# Copy this file to .env and fill in your actual credentials.

POSTGRES_HOST=z-tracs-gj.c5u8ogweeig9.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=ztracs
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_db_password

DATABASE_URL=postgresql://your_db_username:your_secure_db_password@z-tracs-gj.c5u8ogweeig9.ap-south-1.rds.amazonaws.com:5432/ztracs
ENV=production
PORT=5000
HOST=0.0.0.0
JWT_SECRET=your_64_character_hex_jwt_secret

# AWS S3 Evidence Vault Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=ztracs-evidence-vault-dev
AWS_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY
