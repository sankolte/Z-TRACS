{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://43.204.235.231:8000/api/v1/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "http://43.204.235.231:8000/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
